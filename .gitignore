# -----------------------------
# GLOBAL IGNORES (JUNK)
# -----------------------------

# caches
cache/
Cache/
**/cache/
**/Cache/

# runtime state
state/
State/
session/
sessions/
tmp/
temp/

# logs
*.log

# databases / locks
*.db
*.sqlite
*.lock
*.pid
*.sock

# editor junk
*.swp
*.swo
*~
*.bak
*backup*

# secrets / keys
*.key
*.pem
*.crt
*.token
*secret*
*password*
*credentials*

# thumbnails / previews
Thumbs.db

# misc system noise
.recently-used.xbel